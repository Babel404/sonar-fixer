# --- SonarQube -------------------------------------------------------------
SONAR_URL=https://sonar.mon-entreprise.fr
# Jeton utilisateur : Mon compte > Securite > Generer un jeton
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxx
# Cle du projet (visible dans l'URL Sonar : ...?id=<cle>)
SONAR_PROJECT_KEY=calypso
# Optionnel : branche analysee par Sonar (vide = branche principale)
SONAR_BRANCH=

# --- LLM interne (API compatible OpenAI) -----------------------------------
# Meme URL que dans la config Mistral Vibe (avec ou sans /v1)
MISTRAL_URL=https://mistral.interne.mon-entreprise.fr/v1
MISTRAL_API_KEY=
MISTRAL_MODEL=devstral-medium-2512

# --- Repo local --------------------------------------------------------------
# Clone local du repo, sur la MEME branche que celle analysee par Sonar
# (chemin avec espaces ou accents : pas de guillemets necessaires)
REPO_PATH=C:\dev\calypso
# Optionnel : sous-dossier si Sonar analyse depuis un sous-dossier du repo
SOURCE_ROOT=

# Commande de compilation, lancee depuis REPO_PATH apres chaque correction.
# {module_dir} = dossier du module (pom.xml / build.gradle / build.xml le plus proche)
# {file}       = fichier modifie
# Exemples :
#   BUILD_CMD=mvn -q -o compile -f {module_dir}\pom.xml
#   BUILD_CMD=gradlew.bat compileJava -q
#   BUILD_CMD="C:\Program Files\maven\bin\mvn.cmd" -q -o compile -f "{module_dir}\pom.xml"
BUILD_CMD=mvn -q -o compile -f {module_dir}\pom.xml
# Optionnel : tests a lancer en plus (vide = pas de tests)
TEST_CMD=

# --- Reseau ------------------------------------------------------------------
# Optionnel : certificat de l'entreprise (.pem) si erreur CERTIFICATE_VERIFY_FAILED
CA_BUNDLE=

# Optionnel : encodage des sources (vide = detection automatique fichier par fichier :
# UTF-8, UTF-8 avec BOM, Windows-1252/ANSI, ISO-8859-1). A forcer seulement si besoin.
SOURCE_ENCODING=

# --- Reglages (les valeurs par defaut conviennent) ---------------------------
# CONTEXT_LINES=30
# MAX_CHANGED_LINES=40
# BUILD_TIMEOUT=1800
# LLM_TIMEOUT=180
# VERIFY_LINE_HASH=true
